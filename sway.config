# ==============================================================================
# SWAY CONFIGURATION (KDE MIGRATION & NATIVE WAYLAND + NVIDIA SUPPORT)
# ==============================================================================

# Mod Tuşu (Meta / Windows Tuşu)
set $mod Mod4

# Yön Tuşları (Vim Stili - HJKL)
set $left h
set $down j
set $up k
set $right l

# Terminal (Alacritty)
set $term alacritty

# ------------------------------------------------------------------------------
# 1. OTOMATİK BAŞLATMA (AUTOSTART / EXEC)
# ------------------------------------------------------------------------------

# Polkit Ajanı (GUI Sudo / Şifre Ekranı İçin)
exec /usr/lib/polkit-kde-authentication-agent-1

# Durum Çubuğu (Waybar) & Bildirim Yöneticisi (Mako)
exec waybar
exec mako

# Ağ ve Bluetooth Sistem Tepsi İkonları (NetworkManager & Blueman)
exec nm-applet --indicator
exec blueman-applet

# Pano Geçmişi Servisi (Cliphist - Metin ve Görsel Takibi)
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# ------------------------------------------------------------------------------
# 2. UYGULAMA BAŞLATICI KISAYOLLARI
# ------------------------------------------------------------------------------

# Alacritty Terminal (Meta+Return veya Meta+R)
bindsym $mod+Return exec $term
bindsym $mod+r exec $term

# LibreWolf Web Browser (Meta+F)
bindsym $mod+f exec librewolf

# ZapZap WhatsApp Client (Meta+Z)
bindsym $mod+z exec zapzap

# Dolphin Dosya Yöneticisi (Meta+E)
bindsym $mod+e exec dolphin

# Sistem İzleyici / System Monitor (Esc)
bindsym Escape exec plasma-systemmonitor

# Uygulama Menüsü - Rofi (Alt+Space veya Alt+F2)
bindsym Mod1+space exec rofi -show drun
bindsym Mod1+F2 exec rofi -show drun

# Emoji Seçici (Meta+.)
bindsym $mod+period exec rofi -modi emoji -show emoji

# Pano Geçmişi Menüsü (Meta+Shift+V) -> Çakışma Düzeltildi
bindsym $mod+Shift+v exec cliphist list | rofi -dmenu -p "Pano" | cliphist decode | wl-copy

# Power/Logout Menüsü (Meta+Shift+E)
bindsym $mod+Shift+e exec wlogout

# ------------------------------------------------------------------------------
# 3. EKRAN GÖRÜNTÜSÜ VE KAYIT (grim + slurp + swappy)
# ------------------------------------------------------------------------------

# Ekran Bölgesi Seç -> Swappy ile Aç/Düzenle (Print veya Meta+Shift+S)
bindsym Print exec grim -g "$(slurp)" - | swappy -f -
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | swappy -f -

# Ekran Bölgesi Seç -> Doğrudan Panoya Kopyala (Shift+Print)
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy

# Tam Ekran Görüntüsü Al -> Resimler Klasörüne Kaydet (Ctrl+Print)
bindsym Ctrl+Print exec grim ~/Pictures/ps_$(date +'%Y-%m-%d_%H%M%S').png

# Ekran Kaydı Başlat/Durdur (Meta+Shift+R)
bindsym $mod+Shift+r exec wf-recorder -g "$(slurp)" -f ~/Videos/recording_$(date +'%Y-%m-%d_%H%M%S').mp4

# ------------------------------------------------------------------------------
# 4. PENCERE VE TILING YÖNETİMİ
# ------------------------------------------------------------------------------

# Pencere Kapatma (Meta+Shift+Q veya Alt+F4)
bindsym $mod+Shift+q kill
bindsym Mod1+F4 kill

# Odak Değiştirme (Vim Yönleri - HJKL)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Odak Değiştirme (Ok Tuşları - Krohnkite Mantığı)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Pencere Taşıma (Meta+Shift + HJKL)
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Pencere Taşıma (Meta+Shift + Ok Tuşları)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Yüzen Pencere Moda Geçme (Meta+Shift+F)
bindsym $mod+Shift+f floating toggle

# Tam Ekran Yapma (KWin Maximize - Meta+PgUp)
bindsym $mod+Prior fullscreen toggle

# Layout Düzenleri (Split / Stacking / Tabbed)
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split  # -> Meta+E çakışması için Meta+T yapıldı

# Resizing (Pencere Boyutlandırma Modu: Meta+Ctrl+H/L)
mode "resize" {
    bindsym $left resize shrink width 10 px
    bindsym $down resize grow height 10 px
    bindsym $up resize shrink height 10 px
    bindsym $right resize grow width 10 px

    bindsym Left resize shrink width 10 px
    bindsym Down resize grow height 10 px
    bindsym Up resize shrink height 10 px
    bindsym Right resize grow width 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+ctrl+h mode "resize"
bindsym $mod+ctrl+l mode "resize"

# ------------------------------------------------------------------------------
# 5. SANAL MASAÜSTÜ (WORKSPACE) GEÇİŞLERİ & ÇOKLU MONİTÖR
# ------------------------------------------------------------------------------

# Workspace Değiştirme ($mod + 1..4 veya Ctrl+F1..F4)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

bindsym Ctrl+F1 workspace number 1
bindsym Ctrl+F2 workspace number 2
bindsym Ctrl+F3 workspace number 3
bindsym Ctrl+F4 workspace number 4

# Odaktaki Pencereyi Workspace'e Taşıma ($mod + Shift + 1..4)
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

# Ekranlar/Monitörler Arası Pencere Taşıma (Meta+Shift+Sol/Sağ)
bindsym $mod+Shift+Greater move container to output right
bindsym $mod+Shift+Less move container to output left

# ------------------------------------------------------------------------------
# 6. MEDYA, SES VE PARLAKLIK KONTROLLERİ
# ------------------------------------------------------------------------------

# Ses Kontrolü (PipeWire / WirePlumber)
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Ekran Parlaklığı (brightnessctl)
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Medya Tuşları (playerctl)
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioStop exec playerctl stop

# ------------------------------------------------------------------------------
# 7. KLAVYE DÜZENİ VE EKRAN KİLİT
# ------------------------------------------------------------------------------

# Klavye Düzeni Değiştirme (Meta+Space ile TR/US Geçişi)
input "type:keyboard" {
    xkb_layout "tr,us"
    xkb_options "grp:win_space_toggle"
}

# Ekran Kilitleme (Meta+Alt+L) -> Vim 'l' tuşu çakışması önlendi
bindsym $mod+Mod1+l exec swaylock -c 000000

# Sway Yapılandırmasını Yeniden Yükle
bindsym $mod+Shift+c reload
